#extend("base"):
  #export("body"):
    <div class="flex flex-col justify-center gap-6">
      <div>
        <h2 class="mt-2 text-center text-2xl font-bold leading-9 tracking-tight text-gray-900">Third-Party Access</h2>
        <p class="mt-2 text-center text-sm text-gray-600">Services that can act on <span class="font-semibold">#(username)</span>’s account</p>
      </div>

      <section class="space-y-3">
        #if(count(grants) == 0):
          <p class="text-sm text-gray-500">No service has access to this account.</p>
        #else:
          <ul class="space-y-2">
            #for(grant in grants):
              <li class="rounded-lg border border-gray-200 bg-white px-3 py-3">
                <div class="flex items-start justify-between gap-3">
                  <div class="min-w-0 space-y-1">
                    <p class="truncate text-sm font-medium text-gray-900">#(grant.serviceName)</p>
                    <ul class="space-y-1">
                      #for(scope in grant.scopes):
                        <li class="text-xs text-gray-600">#(scope.description)</li>
                      #endfor
                    </ul>
                    <p class="text-xs text-gray-500">
                      Granted #date(grant.createdAt, "d MMM yyyy")#if(grant.lastUsedAt): · last used #date(grant.lastUsedAt, "d MMM yyyy, HH:mm")#endif
                    </p>
                  </div>
                  <form action="/access/#(grant.id)/revoke" method="POST"
                        onsubmit="return confirm('Revoke access for #(grant.serviceName)?');">
                    <button type="submit" class="rounded-md border border-red-200 px-3 py-1 text-xs font-medium text-red-700 hover:bg-red-50">Revoke</button>
                  </form>
                </div>
              </li>
            #endfor
          </ul>
        #endif
        <p class="text-xs text-gray-500">Revoking takes effect at once. A service may finish an action it already started within five minutes.</p>
      </section>

      <div class="flex justify-center">
        <a href="/private" class="btn-soft">Back to Private</a>
      </div>
    </div>
  #endexport
#endextend
