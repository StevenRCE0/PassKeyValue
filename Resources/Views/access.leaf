#extend("base"):
  #export("body"):
    <div class="flex flex-col gap-6">
      <div>
        <a href="/private" class="back-link">‹ Account</a>
        <h1 class="title mt-4">Third-party access</h1>
        <p class="subtitle">Services that can act on <span class="emphasis">#(username)</span>’s account</p>
      </div>

      #if(count(grants) == 0):
        <p class="status">No service has access to this account.</p>
      #else:
        <ul class="list">
          #for(grant in grants):
            <li class="list-row items-start">
              <div class="min-w-0 space-y-1">
                <p class="truncate text-sm font-medium">#(grant.serviceName)</p>
                #if(grant.serviceDomain):
                  <p class="truncate text-xs muted">#(grant.serviceDomain)</p>
                #endif
                #for(scope in grant.scopes):
                  <p class="text-sm muted">#(scope.description)</p>
                #endfor
                <p class="text-xs muted">
                  Authorised #date(grant.createdAt, "d MMM yyyy")#if(grant.lastUsedAt): · last used #date(grant.lastUsedAt, "d MMM yyyy, HH:mm")#endif
                </p>
              </div>
              <form action="/access/#(grant.id)/revoke" method="POST"
                    data-confirm-action="revoke:#(grant.id)" data-question="Revoke access for #(grant.serviceName)?">
                <input type="hidden" name="confirmation">
                <button type="submit" class="btn-danger">Revoke</button>
              </form>
            </li>
          #endfor
        </ul>
      #endif

      <p class="text-xs muted">Each device you authorise is listed on its own. Revoking takes effect at once, after you confirm with your passkey.</p>
      <p id="status" class="status empty:hidden"></p>

      #if(count(appData) > 0):
        <div>
          <h2 class="text-sm font-medium">Data kept by apps</h2>
          <ul class="list mt-2">
            #for(app in appData):
              <li class="list-row items-start">
                <div class="min-w-0 space-y-1">
                  <p class="truncate text-sm font-medium">#(app.name)</p>
                  #if(app.domain):
                    <p class="truncate text-xs muted">#(app.domain)</p>
                  #endif
                  <p class="text-xs muted">#(app.count) #if(app.count == 1):entry#else:entries#endif</p>
                </div>
                #if(app.hasAccess):
                  <p class="text-xs muted">Revoke access to delete</p>
                #else:
                  <form action="/access/data/delete" method="POST"
                        data-confirm-action="delete-data:#(app.namespace)" data-question="Delete everything #(app.name) kept here?">
                    <input type="hidden" name="namespace" value="#(app.namespace)">
                    <input type="hidden" name="confirmation">
                    <button type="submit" class="btn-danger">Delete</button>
                  </form>
                #endif
              </li>
            #endfor
          </ul>
        </div>
      #endif
    </div>
    <script type="application/javascript" src="/scripts/base64.js"></script>
    <script type="application/javascript" src="/scripts/utils.js"></script>
    <script type="application/javascript" src="/scripts/passkey/shared.js"></script>
    <script type="application/javascript" src="/scripts/access.js"></script>
  #endexport
#endextend
