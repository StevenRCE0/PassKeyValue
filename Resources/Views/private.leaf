#extend("base"):
  #export("body"):
    <div class="flex flex-col gap-8">
      <div>
        <h1 class="title">Your account</h1>
        <p class="subtitle">Signed in as <span class="emphasis">#(username)</span></p>
      </div>

      <nav class="list">
        <a href="/kv" class="list-row">
          <span class="text-sm font-medium">Key-value storage</span>
          <span class="muted">›</span>
        </a>
        <a href="/access" class="list-row">
          <span class="text-sm font-medium">Third-party access</span>
          <span class="muted">›</span>
        </a>
      </nav>

      <section class="flex flex-col gap-3">
        <div class="flex items-center justify-between">
          <h2 class="section-title">Passkeys</h2>
          <button id="refreshPasskeysButton" type="button" class="link-action hidden">Refresh</button>
        </div>
        <p id="passkeysStatus" class="status"></p>
        <ul id="passkeysList" class="list"></ul>
      </section>

      <form id="mergeChoiceForm" class="actions">
        <button type="button" data-merge-action="registration" class="action">Add a passkey</button>
        <button type="button" data-merge-action="existing" class="action">Merge accounts</button>
      </form>

      <form id="mergeForm" class="flex flex-col gap-4 hidden">
        <input id="mergeBMode" name="mergeBMode" type="hidden" value="registration">
        <input id="mergeMode" name="mergeMode" type="hidden" value="keepCurrentUser">
        <div id="mergePasskeyNameContainer">
          <label for="mergePasskeyName" class="label">Passkey name</label>
          <input id="mergePasskeyName" name="mergePasskeyName" type="text" placeholder="My Passkey" class="field">
        </div>
        <div class="actions">
          <button id="mergeBackButton" type="button" class="action">Go back</button>
          <button type="submit" class="action action-primary">Continue</button>
        </div>
      </form>

      <div class="space-y-2 hidden">
        <p id="status" class="status"></p>
        <pre id="output" class="output"></pre>
      </div>

      <form action="/logout" method="POST" class="actions card-actions">
        <button type="submit" class="action">Sign out</button>
      </form>
    </div>

    <script type="application/javascript" src="/scripts/base64.js"></script>
    <script type="application/javascript" src="/scripts/utils.js"></script>
    <script type="application/javascript" src="/scripts/passkey/shared.js"></script>
    <script type="application/javascript" src="/scripts/passkey/passkeys.js"></script>
    <script type="application/javascript" src="/scripts/passkey/auth-merge.js"></script>
    <script type="application/javascript" src="/scripts/passkey/init.js"></script>
  #endexport
#endextend
