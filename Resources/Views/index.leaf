#extend("base"):
  #export("body"):
    <div class="flex flex-col gap-6">
      <div>
        <h1 class="title">Welcome</h1>
        <p class="subtitle">Sign in with a passkey, or create one.</p>
      </div>

      <div class="space-y-2 hidden">
        <p id="status" class="status"></p>
        <pre id="output" class="output"></pre>
      </div>

      <form id="authChoiceForm" class="actions card-actions">
        <button type="button" data-auth-mode="registration" class="action">Create a passkey</button>
        <button type="button" data-auth-mode="authentication" class="action action-primary">Sign in</button>
      </form>

      <form id="authForm" class="flex flex-col gap-4 hidden">
        <input id="mode" name="mode" type="hidden" value="registration">
        <div id="authPasskeyNameContainer">
          <label for="passkeyName" class="label">Passkey name</label>
          <input id="passkeyName" name="passkeyName" type="text" placeholder="My Passkey" class="field">
        </div>
        <div class="actions card-actions mt-4">
          <button id="authBackButton" type="button" class="action">Go back</button>
          <button type="submit" class="action action-primary">Continue</button>
        </div>
      </form>
    </div>

    <script type="application/javascript" src="/scripts/base64.js"></script>
    <script type="application/javascript" src="/scripts/utils.js"></script>
    <script type="application/javascript" src="/scripts/passkey/shared.js"></script>
    <script type="application/javascript" src="/scripts/passkey/passkeys.js"></script>
    <script type="application/javascript" src="/scripts/passkey/auth-merge.js"></script>
    <script type="application/javascript" src="/scripts/passkey/init.js"></script>
  #endexport
#endextend
