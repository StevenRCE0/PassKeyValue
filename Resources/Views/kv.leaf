#extend("base"):
  #export("body"):
    <div class="flex flex-col gap-8">
      <div>
        <a href="/private" class="back-link">‹ Account</a>
        <h1 class="title mt-4">Key-value storage</h1>
        <p class="subtitle">Entries for <span class="emphasis">#(username)</span></p>
      </div>

      <section class="flex flex-col gap-3">
        <div class="flex items-center justify-between">
          <h2 class="section-title">Entries</h2>
          <button id="refreshKvButton" type="button" class="link-action hidden">Refresh</button>
        </div>
        <p id="kvStatus" class="status"></p>
        <ul id="kvList" class="list"></ul>
      </section>

      <form id="updateKvForm" class="flex flex-col gap-3">
        <h2 class="section-title">Set a value</h2>
        <div>
          <label for="updateKey" class="label">Key</label>
          <input id="updateKey" type="text" class="field">
        </div>
        <div>
          <label for="updateValue" class="label">Value</label>
          <input id="updateValue" type="text" class="field">
        </div>
        <button type="submit" class="link-action">Save</button>
      </form>

      <form id="getKvForm" class="flex flex-col gap-3">
        <h2 class="section-title">Look up</h2>
        <div>
          <label for="getKey" class="label">Key</label>
          <input id="getKey" type="text" class="field">
        </div>
        <button type="submit" class="link-action">Fetch</button>
      </form>

      <form id="deleteKvForm" class="flex flex-col gap-3">
        <h2 class="section-title">Remove</h2>
        <div>
          <label for="deleteKey" class="label">Key</label>
          <input id="deleteKey" type="text" class="field">
        </div>
        <button type="submit" class="link-action">Delete</button>
      </form>

      <section class="flex flex-col gap-3">
        <h2 class="section-title">Response</h2>
        <pre id="kvOutput" class="output"></pre>
      </section>
    </div>

    <script type="application/javascript" src="/scripts/kvManager.js"></script>
  #endexport
#endextend
